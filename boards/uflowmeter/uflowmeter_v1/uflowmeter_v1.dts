/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * uflowmeter v1 — custom ultrasonic-flow-meter board built around an
 * STM32L151RC (Cortex-M3, 256 KB flash, 32 KB SRAM).
 *
 * Pin map sourced from the embassy port at rework/embassy:src/main.rs
 * lines 117–301. Every assignment here is mirrored in
 * src/pinout.hpp — keep them in sync.
 */

/dts-v1/;
#include <st/l1/stm32l151Xc.dtsi>
#include <st/l1/stm32l151r(8-b-c)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "uflowmeter v1";
	compatible = "uflowmeter,uflowmeter-v1";

	chosen {
		zephyr,console      = &usart1;
		zephyr,shell-uart   = &usart1;
		zephyr,sram         = &sram0;
		zephyr,flash        = &flash0;
		uflowmeter,lcd      = &hd44780;
		uflowmeter,keypad   = &keypad;
		uflowmeter,eeprom   = &eeprom;
	};

	aliases {
		lcd-power = &lcd_power;
		lcd-backlight = &backlight;
	};

	/*
	 * The HD44780 LCD is wired up as a child node with a custom binding
	 * (dts/bindings/display/uflowmeter,hd44780.yaml). Power + backlight
	 * are surfaced separately as gpio-leds so app code can toggle them
	 * during idle-mode power-gating without owning the LCD driver.
	 */
	hd44780: hd44780 {
		compatible = "uflowmeter,hd44780";
		rs-gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
		rw-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
		e-gpios  = <&gpioc 3 GPIO_ACTIVE_HIGH>;
		d4-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
		d5-gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
		d6-gpios = <&gpioa 6 GPIO_ACTIVE_HIGH>;
		d7-gpios = <&gpioa 7 GPIO_ACTIVE_HIGH>;
		rows = <2>;
		cols = <16>;
		status = "okay";
	};

	/* Power rails as gpio-leds so they're trivial to toggle from C++. */
	rails {
		compatible = "gpio-leds";
		lcd_power: lcd_power {
			gpios = <&gpioc 0 GPIO_ACTIVE_LOW>;
			label = "LCD VCC enable (active-LOW)";
		};
		backlight: backlight {
			gpios = <&gpioc 5 GPIO_ACTIVE_LOW>;
			label = "LCD backlight (active-LOW)";
		};
		/*
		 * RS-485 transceiver power for USART1. Held LOW = transceiver
		 * powered. Declared so we can flip it via a single GPIO API
		 * call later when Modbus comes online.
		 */
		rs485_power: rs485_power {
			gpios = <&gpioc 9 GPIO_ACTIVE_LOW>;
			label = "RS-485 transceiver power (active-LOW)";
		};
	};

	keypad: keypad {
		compatible = "gpio-keys";
		btn_config: button_config {
			label = "Config";
			gpios = <&gpiob 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_MENU>;
		};
		btn_enter: button_enter {
			label = "Enter";
			gpios = <&gpiob 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_ENTER>;
		};
		btn_down: button_down {
			/* UI convention maps this to LEFT (see CLAUDE.md). */
			label = "Down/Left";
			gpios = <&gpiob 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_LEFT>;
		};
		btn_up: button_up {
			label = "Up/Right";
			gpios = <&gpiob 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_RIGHT>;
		};
	};

	/*
	 * EEPROM HOLD (PC11) and WP (PC12) are active-LOW; we hold both
	 * lines HIGH at boot via gpio-leds (default "off" state on
	 * active-LOW pins drives the line electrically HIGH = write-
	 * enabled / data-clocked). These need to be live before any
	 * SPI transaction so the chip doesn't latch wrong state.
	 */
	eeprom_pins {
		compatible = "gpio-leds";
		eeprom_hold: eeprom_hold {
			gpios = <&gpioc 11 GPIO_ACTIVE_LOW>;
			label = "25LC1024 HOLD (active-LOW, held HIGH)";
		};
		eeprom_wp: eeprom_wp {
			gpios = <&gpioc 12 GPIO_ACTIVE_LOW>;
			label = "25LC1024 WP (active-LOW, held HIGH)";
		};
	};

	/*
	 * Placeholder declarations for pins reserved by future drivers.
	 * Disabled — exist only to make the pin commitments visible in
	 * the device tree until the corresponding driver lands.
	 */
	reserved-pins {
		compatible = "gpio-leds";
		status = "disabled";
		tdc1000_en:  tdc1000_en  { gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>; label = "TDC1000 EN";  };
		tdc1000_rst: tdc1000_rst { gpios = <&gpioc 6  GPIO_ACTIVE_LOW>;  label = "TDC1000 RST"; };
		tdc7200_en:  tdc7200_en  { gpios = <&gpiob 1  GPIO_ACTIVE_HIGH>; label = "TDC7200 EN";  };
	};
};

/*
 * Clock tree: 8 MHz HSE crystal → MCO out on PA8 at /1 (drives TDC chips).
 * SYSCLK on HSE×2/1 via PLL = 16 MHz (Zephyr issue #22078: do NOT exceed
 * 16 MHz on L1 with shell + SysTick).
 */
&clk_hse {
	status = "okay";
	clock-frequency = <DT_FREQ_M(8)>;
};

&pll {
	div = <3>;            /* HSE 8 MHz / 3 */
	mul = <6>;            /* × 6 = 16 MHz VCO out */
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(16)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
	apb2-prescaler = <1>;
};

/* MCO output on PA8 — HSE / 1 = 8 MHz reference for TDC1000 / TDC7200. */
&mco1 {
	clocks = <&rcc STM32_SRC_HSE MCO1_SEL(0)>;
	prescaler = <1>;
	pinctrl-0 = <&rcc_mco_pa8>;
	pinctrl-names = "default";
	status = "okay";
};

/* USART1: TX=PA9, RX=PA10. 115200 baud. Console for now; Modbus later. */
&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/*
 * SPI2 shared bus: SCK=PB13, MISO=PB14, MOSI=PB15.
 * Three chip-selects committed in the cs-gpios array — only EEPROM has a
 * child node so far; TDC1000 (reg=1) and TDC7200 (reg=2) land in the
 * follow-up TDC commit.
 */
&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	cs-gpios = <&gpioc 10 GPIO_ACTIVE_LOW>,  /* 25LC1024 EEPROM */
		   <&gpiob 11 GPIO_ACTIVE_LOW>,  /* TDC1000 (reserved) */
		   <&gpiob 12 GPIO_ACTIVE_LOW>;  /* TDC7200 (reserved) */
	status = "okay";

	eeprom: eeprom@0 {
		/*
		 * 25LC1024 is command-compatible with the Atmel AT25 family
		 * (READ 0x03 / WRITE 0x02 / WREN 0x06 / RDSR 0x05). Zephyr's
		 * atmel,at25 driver handles page-split writes and WIP polling
		 * — no custom driver needed.
		 */
		compatible = "atmel,at25";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(1)>;
		size = <DT_SIZE_K(1024)>;        /* 128 KB = 1024 Kbit */
		pagesize = <256>;
		address-width = <24>;
		timeout = <5>;                   /* WIP poll timeout, ms */
		status = "okay";
	};
};

/* RTC: STM32L1 internal, LSI/LSE clocked. Backup registers usable. */
&rtc {
	status = "okay";
};

/*
 * Override flash/SRAM sizes for the C variant — the upstream dtsi targets
 * the largest die in the family.
 */
&flash0 {
	reg = <0x08000000 DT_SIZE_K(256)>;
};

&sram0 {
	reg = <0x20000000 DT_SIZE_K(32)>;
};
